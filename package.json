{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --parallel --filter @blog/web --filter @blog/admin dev",
    "dev:web": "pnpm --filter @blog/web dev",
    "dev:admin": "pnpm --filter @blog/admin dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @blog/web build",
    "build:admin": "pnpm --filter @blog/admin build",
    "start:web": "pnpm --filter @blog/web start",
    "start:admin": "pnpm --filter @blog/admin start",
    "clean": "rm -rf node_modules apps/*/node_modules pnpm-lock.yaml apps/*/.next && pnpm store prune && pnpm install",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "type-check": "pnpm -r type-check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.8.1",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1"
  },
  "lint-staged": {
    "apps/**/*.{js,ts,jsx,tsx,json,css,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
