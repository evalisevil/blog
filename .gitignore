# Monorepo: 공통 규칙 — apps/admin, apps/web 및 향후 apps/* 에 동일 적용
# https://help.github.com/articles/ignoring-files/

# dependencies
node_modules

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage

# next.js (모든 앱·패키지)
**/.next/
**/out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env (커밋이 필요하면 ! 로 예외 추가)
.env*

# vercel
**/.vercel

# typescript
*.tsbuildinfo
**/next-env.d.ts

*storybook.log
storybook-static
